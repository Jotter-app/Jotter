# Supabase project settings (Supabase dashboard -> Project Settings -> API Keys)
# Local values come from `supabase start` output; hosted values from the dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only -- never expose to the client
SUPABASE_SECRET_KEY=

# Resend (transactional reminder emails) -- resend.com -> API Keys
RESEND_API_KEY=

# Web Push VAPID keypair -- generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google Calendar sync (Google Cloud Console -> APIs & Services -> Credentials
# -- a Web application OAuth client with the Calendar API enabled, separate
# from whatever client backs "Continue with Google" sign-in)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Server-only -- 32-byte key (base64) for encrypting stored OAuth tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=
